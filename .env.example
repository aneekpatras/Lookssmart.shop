# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME="Looks Smart Beauty Salon"
APP_ENV=local
# Generate with `php artisan key:generate` after the Phase 1 scaffold exists — never commit a real key.
APP_KEY=
# Local: true. Staging: true (behind auth). Production: MUST be false — stack traces leak paths/secrets.
APP_DEBUG=true
## Must match the host/port you actually browse to — MediaLibrary/asset URLs are built from this,
## and SecurityHeaders' CSP img-src is 'self' only (no cross-origin http:), so a mismatch (e.g. this
## set to localhost while browsing 127.0.0.1) makes every uploaded image silently fail to render.
APP_URL=http://127.0.0.1:8000
# Salon's real timezone — all booking display logic reads this; DB storage is always UTC regardless.
APP_TIMEZONE=UTC
ASSET_URL=
# Phase 14 sub-step 2. Local: blank (no proxy in front of `artisan serve`). Production behind Nginx on
# the SAME host: the loopback address Nginx connects from (typically 127.0.0.1). Behind a load
# balancer: its real IP/CIDR block. Comma-separate multiple. Never leave this as `*` in production —
# see DEPLOYMENT.md.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Argon2id everywhere (Brief §5) — never bcrypt. No local config/hashing.php override needed;
# Laravel merges its package default and reads this var (Phase 3).
HASH_DRIVER=argon2id

# =============================================================================
# DATABASE (target: MySQL 8 / MariaDB 10.11+, InnoDB, utf8mb4)
# Local dev: XAMPP's bundled MariaDB (currently 10.4.32 — below the target floor, accepted as tech
# debt, see State file Decision #11 / §10 #8). root / empty password is XAMPP's default; change it if
# you've secured your local MySQL/MariaDB install.
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=looks_smart_salon
DB_USERNAME=root
DB_PASSWORD=
# Only needed on native XAMPP-style local setups where mysqldump.exe isn't on PATH — leave blank on
# a real Linux server (staging/production), where mysqldump is already on PATH.
DB_DUMP_BINARY_PATH=

# =============================================================================
# REDIS — no longer used anywhere in this app (2026-09-28: migrated cache/session/queue/booking
# slot-locks to the `database` driver for RabHost Economy shared hosting, which has no Redis
# available). Vars kept only in case a future environment re-adds Redis; `config/horizon.php` is
# consequently unused too (Horizon requires a Redis queue connection) — plain `queue:work` via cron
# is the queue worker on this stack. See State file Decision #49/§10 for the migration record.
# =============================================================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

# =============================================================================
# SESSION
# =============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
# true everywhere except quick local debugging — sessions hold auth state.
SESSION_ENCRYPT=true
# Local (plain http): false. Staging/Production (https): MUST be true.
SESSION_SECURE_COOKIE=false
# Admin surface tightens this to Strict at the middleware level in Phase 4; Lax is the app-wide default.
SESSION_SAME_SITE=lax

# =============================================================================
# CACHE / QUEUE — both `database`-backed (see REDIS note above).
# QUEUE_CONNECTION=database requires a worker MUST actually be running
# (`php artisan queue:work --stop-when-empty` on a cron, see DEPLOYMENT.md) or every
# ShouldQueue notification — including booking confirmation/cancellation emails — silently piles up
# unsent. Use `sync` locally instead if you're not running a worker.
# =============================================================================
CACHE_STORE=database
QUEUE_CONNECTION=database

# =============================================================================
# MAIL — Brevo SMTP relay (live booking confirmation/cancellation emails)
# =============================================================================
# Get MAIL_USERNAME/MAIL_PASSWORD from Brevo: Settings → SMTP & API → SMTP tab. Never commit the
# real password — this file only ever holds placeholders. MAIL_USERNAME is Brevo's generated SMTP
# login (looks like "xxxxxxxxx@smtp-brevo.com") — NOT your Brevo account's own login email; using
# the account email here causes a `535 5.7.8 Authentication failed` (confirmed 2026-09-21).
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-generated-id@smtp-brevo.com
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@lookssmartsalon.example
MAIL_FROM_NAME="${APP_NAME}"
# Guaranteed admin alert recipient — used alongside real admin/super-admin user accounts as a
# fallback, in case a seeded/test admin account's own email isn't a real inbox.
ADMIN_NOTIFICATION_EMAIL=lookssmartbeautysalon@gmail.com
RESEND_KEY=
POSTMARK_TOKEN=

# =============================================================================
# ADMIN SEED ACCOUNT — only consumed by database/seeders/DatabaseSeeder.php
# Set a real strong password before running `migrate:fresh --seed` on anything but a throwaway
# local DB. Never commit a real value here — this file only ever holds a blank placeholder.
# =============================================================================
ADMIN_SEED_PASSWORD=

# =============================================================================
# GOOGLE (Calendar sync, Analytics/Tag Manager, Business Profile)
# Google OAuth *login* was removed — only the Phase 8 per-staff Calendar integration remains.
# =============================================================================
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
GOOGLE_BUSINESS_PROFILE_URL=

# =============================================================================
# SMS / WHATSAPP (Twilio) — reminders, booking confirmations
# =============================================================================
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# =============================================================================
# ANTI-ABUSE — Cloudflare Turnstile on contact/booking/review forms
# =============================================================================
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# =============================================================================
# ERROR TRACKING
# =============================================================================
SENTRY_LARAVEL_DSN=
# Lower in production once traffic is real (e.g. 0.1) — 1.0 is fine while pre-launch.
SENTRY_TRACES_SAMPLE_RATE=1.0

# =============================================================================
# S3 (media storage in prod + encrypted off-site backups)
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Local: local (storage/app). Staging/Production: s3.
FILESYSTEM_DISK=local
BACKUP_ARCHIVE_PASSWORD=
# Which disk(s) spatie/laravel-backup writes to. Local: local (dry-run against real local disk).
# Staging/Production: s3 — requires the AWS_* credentials above to actually be filled in.
BACKUP_DISKS=local
BACKUP_NOTIFICATION_EMAIL=

# =============================================================================
# PAYMENTS (Stripe) — only if/when payments are enabled; never store card data ourselves
# =============================================================================
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# FRONTEND (Vite)
# =============================================================================
VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5173
# A browser Sentry DSN is not a secret (it's bundled into the public JS), so it's safe here.
# Leave blank to disable frontend error tracking entirely (e.g. local dev).
VITE_SENTRY_DSN=
VITE_APP_ENV="${APP_ENV}"
